{
  "manifest_version": 3,
  "name": "Kick Chat Filter",
  "version": "0.1.0",
  "description": "Hide Kick chat messages containing your blocked keywords. English and Turkish interface; local-only filtering.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Kick Chat Filter",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kick.com/*",
        "https://www.kick.com/*"
      ],
      "js": [
        "src/shared/normalization.js",
        "src/shared/matcher.js",
        "src/shared/settings.js",
        "src/content/kick-adapter.js",
        "src/content/observer.js",
        "src/content/index.js"
      ],
      "css": [
        "src/content/visibility.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
